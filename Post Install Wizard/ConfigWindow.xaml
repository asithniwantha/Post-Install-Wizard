<Window x:Class="Post_Install_Wizard.ConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Post_Install_Wizard"
        xmlns:viewmodels="clr-namespace:Post_Install_Wizard.ViewModels"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Configuration Wizard" Height="450" Width="800"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{DynamicResource MaterialDesignFont}"
        WindowStartupLocation="CenterOwner">

    <Window.DataContext>
        <viewmodels:ConfigViewModel />
    </Window.DataContext>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Button Content="Add" Command="{Binding AddItemCommand}" Margin="0,0,8,0" Width="80" />
            <Button Content="Delete" Command="{Binding DeleteItemCommand}" Margin="0,0,8,0" Width="80" Foreground="#ef5350" BorderBrush="#ef5350" />
        </StackPanel>

        <DataGrid Grid.Row="1" ItemsSource="{Binding SoftwareList}" SelectedItem="{Binding SelectedSoftware}"
                  AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                <DataGridTextColumn Header="File Name" Binding="{Binding FileName, UpdateSourceTrigger=PropertyChanged}" Width="200" />
                <DataGridTextColumn Header="Silent Arguments" Binding="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                <DataGridCheckBoxColumn Header="Selected by default" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Edit Area (Optional but nice to have below the grid for easier editing of long arguments) -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0" Margin="0,16,0,16" Padding="0,16,0,0">
            <Grid IsEnabled="{Binding IsItemSelected}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSoftware.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="File Name:" VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedSoftware.FileName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Arguments:" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSoftware.Arguments, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Command="{Binding SaveCommand}" Margin="0,0,8,0" Width="100" />
            <Button Content="Close" Click="CloseButton_Click" Style="{StaticResource MaterialDesignOutlinedButton}" Width="100" />
        </StackPanel>
    </Grid>
</Window>